{
  "name": "rehab-robotics-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LabVIEW-style visual programming & control environment for rehabilitation robotics (Level 1.5 foundation, mock data only).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/deployment/*.test.ts src/data/*.test.ts src/graph/*.test.ts",
    "test:frequency-panel": "npm run build && node scripts/frequency-panel-regression.mjs",
    "test:phase19": "npm run build && node scripts/phase19-qa.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
